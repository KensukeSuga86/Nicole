{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nicole.local/schema/constellation.schema.json",
  "title": "Nicole Constellation",
  "type": "object",
  "required": [
    "id",
    "name",
    "season",
    "explanation",
    "representative_position"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "object"
    },
    "season": {
      "type": "string"
    },
    "explanation": {
      "type": "object",
      "required": [
        "science",
        "myth"
      ]
    },
    "representative_position": {
      "type": "object",
      "required": [
        "ra_deg",
        "dec_deg"
      ]
    }
  },
  "additionalProperties": true
}